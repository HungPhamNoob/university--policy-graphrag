# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Source document ---
FILE_PATH=data/UET_HR.pdf

# --- LLM provider (any OpenAI-compatible gateway) ---
# Defaults target the getnexai.net gateway; the `nexai` slug auto-routes to a
# capable model and supports structured output. Any OpenAI-compatible
# base_url + model that supports tool/JSON structured output will work.
API_KEY_2=your-api-key
BASE_URL_2=https://getnexai.net/api/v1
LLM_MODEL=nexai

# --- Neo4j (matches the docker-compose / docker run defaults) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
